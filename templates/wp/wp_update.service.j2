# Managed by Ansible (templates/wp/wp_update.service.j2). One instance per site: wp-update@<site>.service, started by wp-update@<site>.timer.
[Unit]
Description=Nightly update of WordPress site %i (with a rollback)
After=docker.service wp-%i.service
OnFailure=wp-job-failed@%N.service

[Service]
Type=oneshot
ExecStart={{ wp_tools_bin }}/wp-site-update %i
TimeoutStartSec={{ wp_update_timeout_s }}

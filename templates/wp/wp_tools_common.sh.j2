# Managed by Ansible (templates/wp/wp_tools_common.sh.j2). Sourced by wp-site-cli, wp-site-install and wp-site-login-check; not run on its own. Root-only tools:
# there is no sudoers entry and no setuid bit, so nobody can reach them who cannot already be root on this VM.
readonly WP_DATA='{{ wp_data_mount }}/sites'
readonly WP_DOMAIN='{{ wp_domain }}'
readonly WP_LISTEN='{{ wp_nginx_listen_port }}'
readonly WP_BIN='{{ wp_tools_bin }}'
readonly WP_FREEZE='{{ wp_freeze_file }}'
{% raw %}
die() { echo "$(basename "$0"): $*" >&2; exit 2; }

# Sets site, dir and host. The name must look like a site name AND be one that exists: the regex keeps path tricks and globs out, the record keeps typos out. A site exists if it has a registry
# record, site.json, in its directory (written by wp-site-provision; a link does not count). Only the file is looked at, not the registry as a whole, so the tools that finish a half-done job
# (wp-site-delete after an interrupted close) still run when another site's record is bad.
require_site() {
  site=${1:-}
  [[ $site =~ ^[a-z][a-z0-9-]{1,23}$ ]] || die "'$site' is not a site name"
  { [ -f "$WP_DATA/$site/site.json" ] && [ ! -L "$WP_DATA/$site/site.json" ]; } || die "'$site' is not a site (it has no registry record: create it with wp-ctl create)"
  dir=$WP_DATA/$site
  host=$site.$WP_DOMAIN
}

# One line for every site that is not closed, from the registry, as wp-site-provision rows prints them: name state quota_id quota_mb backup_quota_id backup_quota_mb update_policy. The tools that
# watch or report on the sites read this instead of a list baked in by the play. It FAILS when the registry cannot be read, so a caller must take it into a variable first
# (rows=$(site_rows) stops a `set -e` script; a pipe or a `for` over $(site_rows) would turn a broken registry into "no sites" and hide it).
site_rows() { "$WP_BIN/wp-site-provision" rows </dev/null; }

# A stopped site has no containers (templates/wp/site_nginx.conf.j2, tasks/wp_site_one_common.yml render stopped.flag from the state). A tool that needs the stack says so, instead of
# failing on a missing container or network. Call it after require_site.
refuse_if_stopped() { [ ! -e "$dir/stopped.flag" ] || die "$site is stopped (it has no containers); start it first: python3 scripts/wp_sites.py start $site"; }

# The number of tables in a site's database; 0 is a site that is waiting for an import. Fails when the database cannot be asked: the caller decides what that means (a tool that alerts says so).
table_count() {
  docker exec "wp_${1//-/_}_db" sh -c 'MYSQL_PWD="$MARIADB_PASSWORD" exec mariadb -u"$MARIADB_USER" -N -B -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE()" "$MARIADB_DATABASE"' </dev/null
}

# Opens fd 3 on the terminal (WP_SITE_TTY exists for the tests). Secrets are read from fd 3, silently, and never put in an argument or the environment.
open_tty() { exec 3<"${WP_SITE_TTY:-/dev/tty}" || die "no terminal to read from (use ssh -t)"; }
ask() { printf '%s' "$1" >&2; IFS= read -r -u 3 "$2" || die "no answer"; }
ask_secret() { printf '%s' "$1" >&2; IFS= read -rs -u 3 "$2" || die "no answer"; echo >&2; }

# WP-CLI's prompt mode keeps a password out of the process list, but then PRINTS it: the typed value on the prompt line, and the command it built with the value in it (seen on dellwp
# 2026-10-24, in a scrollback that was pasted into a chat). A tool that sends a password to WP-CLI pipes everything WP-CLI prints through redact, with the password in $pw: the exact
# value is replaced wherever it appears, and whatever follows --admin_password= or --user_pass= is dropped, which also covers the shell-quoted form (a quote in a password is printed
# as '\'' and would not match the exact value).
redact() {
  local l k
  while IFS= read -r l; do
    l=${l//"$pw"/REDACTED}
    for k in --admin_password= --user_pass=; do
      case $l in *"$k"*) l="${l%%"$k"*}${k}REDACTED" ;; esac
    done
    printf '%s\n' "$l"
  done
}
{% endraw %}

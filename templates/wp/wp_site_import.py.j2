#!/usr/bin/python3 -I
# Managed by Ansible (templates/wp/wp_site_import.py.j2). Bring a .wpress archive into a site on hold:   ssh -t dellwp sudo wp-site-import <site> <file.wpress> [--plan]
# then   wp-site-import approve <site> [--reject a,b]   or   wp-site-import reset <site>   (undo). The logic is {{ wp_tools_lib }}/wp_site_import.py, with the archive reader {{ wp_tools_lib }}/wp_wpress.py (both copied from scripts/ in the
# repo, where tests/test_wp_import.py and tests/test_wp_wpress.py run them); this file only carries the values from the repo. Root-only (0750), like the other wp-site tools. The sites, their states and
# quotas are asked of the registry (wp-site-provision rows) at every run.
import sys

sys.path.insert(0, "{{ wp_tools_lib }}")
import wp_site_import  # noqa: E402

CONFIG = {
    "data_mount": "{{ wp_data_mount }}",
    "intake_dir": "{{ wp_intake_dir }}",
    "backup_dir": "{{ wp_backup_dir }}",
    "intake_quota_mb": {{ wp_intake_quota_mb }},
    "image_pin": "{{ wp_image_php }}",
    "domain": "{{ wp_domain }}",
    "tools_bin": "{{ wp_tools_bin }}",
    "php_uid": {{ wp_php_uid }},
    "step_timeout_s": {{ wp_import_step_timeout_s }},
    "approvals": {"key_file": "{{ wp_approvals_dir }}/key", "approver_file": "{{ wp_approvals_dir }}/approver", "ntfy_conf": "{{ wp_ntfy_conf }}", "netrc": "{{ wp_ntfy_netrc }}",
                  "reply_topic": "{{ wp_approvals_reply_topic }}", "ttl_s": {{ wp_approvals_ttl_s }}},
}
sys.exit(wp_site_import.main(CONFIG, sys.argv[1:]))

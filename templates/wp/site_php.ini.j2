; Managed by Ansible (templates/wp/site_php.ini.j2). Site {{ wp_s.name }}. Loaded after the image's own files (zz-).
memory_limit = {{ wp_s.php_memory_limit }}
upload_max_filesize = {{ wp_s.upload_mb }}M
post_max_size = {{ wp_s.upload_mb }}M
max_execution_time = 60
expose_php = Off
display_errors = Off
log_errors = On
error_log = /proc/self/stderr
allow_url_include = Off
; The session upload-progress feature is the entry point of the PHP2Shell flaws (docs/handoff_wp_hosting_temp.md section 5); WordPress does not use it.
session.upload_progress.enabled = 0
{% if wp_php_open_basedir | int %}
open_basedir = /var/www/html:{{ wp_mu_mount }}:/tmp
{% endif %}
; sort: Ansible's difference filter returns a set operation's result, whose order changes from run to run; unsorted, this file would differ on every run.
disable_functions = {{ wp_php_disable_functions | difference(wp_s.php_allow_functions) | sort | join(',') }}
opcache.memory_consumption = {{ wp_s.opcache_mb }}
opcache.max_accelerated_files = {{ wp_php_opcache_files | int }}
opcache.interned_strings_buffer = {{ wp_php_opcache_strings_mb | int }}
opcache.validate_timestamps = {{ wp_php_opcache_validate | int }}
opcache.revalidate_freq = {{ wp_php_opcache_revalidate_s | int }}
realpath_cache_ttl = {{ wp_php_realpath_ttl_s | int }}
zend.assertions = {{ wp_php_assertions | int }}

# Managed by Ansible (templates/wp/site_nginx.conf.j2). Site {{ wp_s.name }} ({{ wp_s.state }}). Needs the base in wp_base.conf ($wp_https, the wp_login_attempts zone).
{% if wp_s.state == 'stopped' %}
# Stopped: no containers behind this name. Visitors get a plain 503 "paused" page (with a Retry-After); nothing is passed to php, no file is served, no limit zone is needed. The text is
# what scripts/wp_sites_status.py and the tools look for.
server {
    listen 127.0.0.1:{{ wp_nginx_listen_port }};
    listen 127.0.0.1:{{ wp_nginx_probe_port }};
    server_name {{ wp_host }};
    access_log /var/log/nginx/wp_{{ wp_s.name }}.access.log;
    error_log /var/log/nginx/wp_{{ wp_s.name }}.error.log;
    default_type text/plain;
    add_header Retry-After 3600 always;
    return 503 "This site is paused.\n";
}
{% else %}
server {
    listen 127.0.0.1:{{ wp_nginx_listen_port }};
    listen 127.0.0.1:{{ wp_nginx_probe_port }};
    server_name {{ wp_host }};
    root {{ wp_site_dir }}/html;
    index index.php;
    client_max_body_size {{ wp_s.upload_mb }}m;
    access_log /var/log/nginx/wp_{{ wp_s.name }}.access.log wp_timed;
    error_log /var/log/nginx/wp_{{ wp_s.name }}.error.log;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    limit_req zone=wp_login_attempts burst=5 nodelay;

    # Text assets are compressed (nginx compresses text/html on its own). Set here, not in the base: the distribution's nginx.conf already sets gzip in http{}, and the same directive twice in one
    # block fails nginx -t, while a server block may override it.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/rss+xml application/atom+xml image/svg+xml font/ttf font/otf application/vnd.ms-fontobject;
{% if wp_s.state == 'hold' %}

    # On hold: only a local curl gets in (a visitor's address is replaced by CF-Connecting-IP, a local request keeps 127.0.0.1).
    allow 127.0.0.1;
    deny all;
{% endif %}

    # Our own maintenance flag (WordPress ignores a .maintenance file older than 10 minutes); the update job creates and removes it. Requests on the probe port ($wp_probe,
    # reachable only from this VM) skip it, so the job can test the site before it reopens it. (nginx has no "and" in an if: the flag is set, then cleared for the probe.)
    set $wp_maintenance 0;
    if (-f {{ wp_site_dir }}/maintenance.flag) {
        set $wp_maintenance 1;
    }
    if ($wp_probe) {
        set $wp_maintenance 0;
    }
    if ($wp_maintenance) {
        return 503;
    }
{% if not wp_s.allow_user_enum %}
    if ($args ~* "(^|&)author=[0-9]") {
        return 403;
    }
{% endif %}

    # PHP never runs from places a visitor or an upload can write to.
    location ~* ^/wp-content/(uploads|upgrade)/.*\.(php|phar|phtml|php[0-9])$ {
        return 403;
    }
    location ~* ^/wp-content/.*\.(sql|zip|tar|gz|log|bak)$ {
        return 403;
    }
    location ~* ^/wp-content/(ai1wm-backups|backup|backups|backup-db|updraft)/ {
        return 403;
    }
    location ~* ^/wp-content/debug\.log$ {
        return 403;
    }
    location ~ /\.(?!well-known) {
        return 403;
    }
    location ~* ^/(readme\.html|license\.txt|wp-config\.php|wp-config-sample\.php)$ {
        return 404;
    }
{% if not wp_s.allow_xmlrpc %}
    location = /xmlrpc.php {
        return 403;
    }
{% endif %}

    # The hosting service's must-use plugins load scripts and styles from WPMU_PLUGIN_URL (/wp-mu); the directory is on this host, root-owned. A plain prefix on purpose: the \.php$ location below
    # still wins for a .php name and finds nothing under the site root, so plugin PHP is never served as text.
    location ^~ /wp-mu/ {
        alias {{ wp_mu_dir }}/;
        expires 7d;
        location ~ \.php$ {
            return 403;
        }
    }

    # Static files: nginx answers and PHP never starts. A file that is not there is a plain 404 instead of a WordPress boot (about 0.4 s each); one that is there carries a month's cache lifetime
    # (WordPress puts ?ver= on its own files, so a new version is a new address). .ico is left out on purpose: WordPress answers /favicon.ico itself when the site has no icon file.
    # The headers are repeated because a location with its own add_header drops the server's. A plugin that makes an image or style sheet up on request (no file behind it) would 404 here.
    location ~* \.(?:css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|woff2?|ttf|otf|eot)$ {
        try_files $uri =404;
        expires 30d;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
{% if wp_page_cache_s | int > 0 %}
        # Anonymous pages are kept {{ wp_page_cache_s | int }} s (the zone and the skip rules: tasks/wp_nginx_base_common.yml). A stale page is served while PHP refreshes it or if PHP errors; only one request
        # per page goes to PHP at a time. A response that sets a cookie or says no-cache (WooCommerce's cart and checkout do) is never stored: nginx obeys the headers WordPress sends.
        fastcgi_cache {{ wp_page_cache_zone }};
        fastcgi_cache_key "$wp_https$request_method$host$request_uri";
        fastcgi_cache_valid 200 301 302 {{ wp_page_cache_s | int }}s;
        fastcgi_cache_valid 404 1m;
        fastcgi_cache_bypass $wp_skip_cache;
        fastcgi_no_cache $wp_skip_cache;
        fastcgi_cache_lock on;
        fastcgi_cache_use_stale error timeout updating http_500 http_503;
        fastcgi_cache_background_update on;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
{% endif %}
        # The php container sees the site at /var/www/html, not at {{ wp_site_dir }}/html.
        fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT /var/www/html;
        fastcgi_param HTTPS $wp_https;
        fastcgi_pass 127.0.0.1:{{ wp_s.port }};
        fastcgi_read_timeout 60s;
    }
}
{% endif %}

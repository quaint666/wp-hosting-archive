#!/bin/bash
# Managed by Ansible (templates/wp/wp_site_password.sh.j2). Change a WordPress user's password:   ssh -t dellwp sudo wp-site-password <site> <user>
# Asks for the new password twice at a hidden prompt (14 characters or more); there is no option for it, on purpose. The password goes to WP-CLI on stdin, never in an argument, a file or
# the environment, and everything WP-CLI prints goes through redact (tools library), because WP-CLI's prompt mode prints the value. Then it ends every other session of that user
# (`wp user session destroy --all`: a changed password does not log an old session out by itself), and proves the result like wp-site-install does: the new password must log in and the
# same password with a letter added must be refused. Nothing here sends mail (the VM cannot send SMTP). The user must already exist on the site; this does not create one.
set -eu
. {{ wp_tools_lib }}/common.sh
{% raw %}
usage() { echo "usage: wp-site-password <site> <user>   (run with ssh -t)" >&2; exit 2; }
[ "$#" -eq 2 ] || usage
require_site "$1"; user=$2
refuse_if_stopped
[[ $user =~ ^[A-Za-z0-9_.@-]{1,60}$ ]] || die "'$user' is not a plausible user name"
"$WP_BIN/wp-site-cli" "$site" user get "$user" --field=ID >/dev/null 2>&1 </dev/null || die "$site has no user '$user'; nothing was changed"
open_tty
ask_secret "New password for $user (14 or more characters, not shown): " pw
ask_secret "Password again: " pw2
[ "$pw" = "$pw2" ] || die "the two passwords differ; nothing was changed"
[ "${#pw}" -ge 14 ] || die "the password has ${#pw} characters; 14 or more are needed"
unset pw2
echo "password: ${#pw} characters, the two entries match" >&2

set -o pipefail
printf '%s\n' "$pw" | "$WP_BIN/wp-site-cli" "$site" --stdin user update "$user" --prompt=user_pass 2>&1 | redact >&2
set +o pipefail
"$WP_BIN/wp-site-cli" "$site" user session destroy "$user" --all </dev/null >&2

rc=0
if printf '%s' "$pw" | "$WP_BIN/wp-site-login-check" "$site" "$user"; then right=ok; else right=FAILED; rc=1; fi
if printf '%s' "${pw}x" | "$WP_BIN/wp-site-login-check" "$site" "$user" >/dev/null; then wrong="ACCEPTED (bad)"; rc=1; else wrong=refused; fi
unset pw
echo "== password of $user on $host changed and its other sessions ended: right password $right, wrong password $wrong" >&2
exit "$rc"
{% endraw %}

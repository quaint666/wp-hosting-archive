# Managed by Ansible (templates/wp/site_unit.service.j2).
[Unit]
Description=WordPress site {{ wp_s.name }} (Docker Compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ wp_site_dir }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target

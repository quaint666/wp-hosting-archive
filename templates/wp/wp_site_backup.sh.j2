#!/bin/bash
# Managed by Ansible (templates/wp/wp_site_backup.sh.j2). The nightly backup of one site:   wp-site-backup <site> [--force]
# Run by wp-backup@<site>.timer every night for every site, on hold or live. One snapshot is a directory named by its UTC time, holding
#   db.sql.gz  a consistent dump (mariadb-dump --single-transaction, as the site's own database user, compressed, checked before it counts)
#   files/     wp-content (plugins, themes, uploads, mu-plugins, languages) as a hard-link snapshot of the previous one: unchanged files cost nothing, so a night is only what changed
#   MANIFEST   what it is (site, time, WordPress version, sizes)
# It is built in a hidden .partial-* directory and renamed into place only when everything checked out, so a half-made snapshot never looks like a backup. Core is not
# saved: it comes from the image (the restore seeds it), and wp-config.php and .env are rendered from the repo and the vault. Snapshots live in their own quota project, so
# the first one is a real copy (a hard link across projects is refused) and the later ones link inside it.
# --tag=final (wp_sites.py stop): the last backup of a site that is about to stop. The site is put in maintenance (nginx answers 503, cron skips) before the dump, so nothing can be written
# between this snapshot and the stop; on success the flag STAYS UP (the stop's play takes it away once the containers are down; run by hand, remove it yourself or stop the site), on a
# failure it comes down again. A flag that was already up is never touched. Tagged snapshots are kept on their own: the newest {{ wp_backup_keep_final }} final one, and what is said below for pre-update.
# --tag=pre-update (the update job): the snapshot is marked in its MANIFEST (tag=pre-update) and pruned on its own: the newest {{ wp_backup_keep_preupdate }} tagged snapshots are kept and they do not count
# towards the daily and weekly ones. Retention: the newest {{ wp_backup_keep_daily }} untagged snapshots, plus the newest of each of the {{ wp_backup_keep_weekly }} calendar weeks (ISO) before the oldest of those. FREEZE: like every per-site
# job, a backup is skipped (as a success) while a freeze flag exists ({{ wp_freeze_file }} or the site's own freeze file): a frozen site and its backup set stay exactly as they are.
# The Proxmox job still backs the whole VM up every night. --force backs up anyway (by hand, e.g. before a manual patch during a freeze); even then NOTHING IS PRUNED while frozen.
# A failure exits non-zero, which fails the unit, whose OnFailure= tells ntfy. ".last-success" holds the stamp of the last good run;
# wp-backup-check alerts when it is older than {{ wp_backup_stale_hours }} hours.
set -eu -o pipefail
. {{ wp_tools_lib }}/common.sh
readonly BACKUPS='{{ wp_backup_dir }}'
readonly KEEP_DAILY='{{ wp_backup_keep_daily }}'
readonly KEEP_WEEKLY='{{ wp_backup_keep_weekly }}'
readonly KEEP_PRE='{{ wp_backup_keep_preupdate }}'
readonly KEEP_FINAL='{{ wp_backup_keep_final }}'
{% raw %}
usage() { echo "usage: wp-site-backup <site> [--force] [--tag=pre-update|--tag=final]" >&2; exit 2; }
[ "$#" -ge 1 ] || usage
require_site "$1"; shift
force=no; tag=""
for a in "$@"; do case $a in --force) force=yes ;; --tag=pre-update) tag=pre-update ;; --tag=final) tag=final ;; *) usage ;; esac; done
frozen=""
for flag in "$WP_FREEZE" "$dir/freeze"; do [ -e "$flag" ] && frozen=$flag; done
if [ -n "$frozen" ] && [ "$force" = no ]; then echo "wp-site-backup: $site is frozen ($frozen exists); skipped (--force backs up anyway)"; exit 0; fi
refuse_if_stopped
dest=$BACKUPS/$site
[ -d "$dest" ] || die "$dest does not exist (run dellwp/wp_sites_dellwp.yml)"
[ -f "$dir/wp-config.php" ] && [ -d "$dir/html/wp-content" ] || die "the site is not set up under $dir"
umask 077
stamp=$(date -u +%Y%m%dT%H%M%SZ)
partial=$dest/.partial-$stamp
made_flag=no; keep_flag=no
cleanup() { rm -rf -- "$partial"; if [ "$made_flag" = yes ] && [ "$keep_flag" = no ]; then rm -f -- "$dir/maintenance.flag"; fi; }
trap cleanup EXIT
if [ "$tag" = final ] && [ ! -e "$dir/maintenance.flag" ]; then touch -- "$dir/maintenance.flag"; made_flag=yes; fi   # quiet the site before the dump; someone else's flag is left alone
mkdir -- "$partial"
db=wp_${site//-/_}_db

# 1. the database. pipefail makes a failing dump fail the whole pipe even though gzip succeeds.
echo "dumping the database of $site"
docker exec "$db" sh -c 'MYSQL_PWD="$MARIADB_PASSWORD" exec mariadb-dump -u"$MARIADB_USER" --single-transaction --quick --routines --events --triggers --default-character-set=utf8mb4 "$MARIADB_DATABASE"' </dev/null \
  | gzip > "$partial/db.sql.gz" || die "mariadb-dump failed"
gzip -t "$partial/db.sql.gz" || die "the dump fails gzip's integrity check"
case "$(gzip -dc "$partial/db.sql.gz" | tail -n 5)" in *"-- Dump completed"*) ;; *) die "the dump has no completion marker (truncated?)" ;; esac
[ "$(gzip -dc "$partial/db.sql.gz" | grep -c '^CREATE TABLE `wp_options`' || true)" -eq 1 ] || die "the dump has no wp_options table (an empty database?)"

# 2. the files, hard-linked against the newest snapshot that is complete
latest=$(find "$dest" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}T[0-9]{6}Z' -printf '%f\n' | LC_ALL=C sort | tail -n 1)
link=(); [ -z "$latest" ] || link=("--link-dest=$dest/$latest/files")
echo "copying wp-content (against ${latest:-nothing: this is a full copy})"
rc=0
rsync -a --delete --exclude=/cache/ --exclude=/upgrade/ --exclude=/debug.log "${link[@]}" "$dir/html/wp-content/" "$partial/files/" || rc=$?
[ "$rc" = 0 ] || [ "$rc" = 24 ] || die "rsync failed (exit $rc)"   # 24 = a file vanished while copying: normal on a live site

# 3. what it is
core=$(sed -n "s/^\$wp_version = '\(.*\)';.*/\1/p" "$dir/html/wp-includes/version.php" | head -n 1)
{
  echo "site=$site"; echo "stamp=$stamp"; echo "core=${core:-unknown}"; [ -z "$tag" ] || echo "tag=$tag"
  echo "dump_bytes=$(stat -c %s "$partial/db.sql.gz")"
  echo "files=$(find "$partial/files" -type f | wc -l)"
  echo "kbytes=$(du -sk "$partial" | cut -f1)"
} > "$partial/MANIFEST"

# 4. only now does it count. (mv into an existing directory would nest the new snapshot inside it, so a same-second collision is refused.)
[ ! -e "$dest/$stamp" ] || die "snapshot $stamp already exists (two runs in the same second?)"
mv -- "$partial" "$dest/$stamp"
trap - EXIT
[ "$made_flag" = no ] || echo "final backup taken: $site is in maintenance and stays so ($dir/maintenance.flag) until it is stopped; remove that file to bring it back"
echo "$stamp" > "$dest/.last-success"
echo "OK: snapshot $stamp of $site ($(grep '^kbytes=' "$dest/$stamp/MANIFEST" | cut -d= -f2) KiB on disk, core $core)"

# 5. retention, unless the site or the host is frozen
if [ -n "$frozen" ]; then echo "frozen ($frozen exists): backed up because of --force; nothing is pruned"; exit 0; fi
week() { local d=${1:0:8}; date -u -d "${d:0:4}-${d:4:2}-${d:6:2}" +%G-%V; }
mapfile -t all < <(find "$dest" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}T[0-9]{6}Z' -printf '%f\n' | LC_ALL=C sort -r)
plain=(); pre=(); fin=()
for s in "${all[@]}"; do
  if grep -qx 'tag=pre-update' "$dest/$s/MANIFEST" 2>/dev/null; then pre+=("$s")
  elif grep -qx 'tag=final' "$dest/$s/MANIFEST" 2>/dev/null; then fin+=("$s")
  else plain+=("$s"); fi
done
keep=" "; n=0; seen=" "; oldest_week=""
for s in "${plain[@]}"; do
  if [ "$n" -lt "$KEEP_DAILY" ]; then keep+="$s "; n=$((n + 1)); oldest_week=$(week "$s"); fi
done
seen+="$oldest_week "; w=0
for s in "${plain[@]}"; do
  case "$keep" in *" $s "*) continue ;; esac
  wk=$(week "$s")
  case "$seen" in *" $wk "*) continue ;; esac
  if [ "$w" -lt "$KEEP_WEEKLY" ]; then keep+="$s "; seen+="$wk "; w=$((w + 1)); fi
done
p=0
for s in "${pre[@]}"; do
  if [ "$p" -lt "$KEEP_PRE" ]; then keep+="$s "; p=$((p + 1)); fi
done
f=0
for s in "${fin[@]}"; do
  if [ "$f" -lt "$KEEP_FINAL" ]; then keep+="$s "; f=$((f + 1)); fi
done
for s in "${all[@]}"; do
  case "$keep" in *" $s "*) ;; *) rm -rf -- "${dest:?}/$s"; echo "pruned $s" ;; esac
done
{% endraw %}

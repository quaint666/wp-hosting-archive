#!/bin/bash
# Managed by Ansible (templates/wp/wp_backup_check.sh.j2). Every hour: is every site still being backed up? A backup job that fails tells ntfy through OnFailure=, but a timer
# that silently stops firing tells nobody, and the first sign would be the day a restore is needed. A site is stale when its newest good backup (.last-success) is
# {{ wp_backup_stale_hours }} hours old or more; a site that has never been backed up is stale once it is that old itself, unless it has no tables and no snapshot (it is waiting for an import). Told once when it starts and once when it ends.
# A STOPPED site (stopped.flag) is skipped for the same reason. A FROZEN site (the global freeze file or its own) is skipped: its backups are paused on purpose, so "stale" would be noise. It is judged again once unfrozen, which can raise one alert
# before the next night's backup after a long freeze. WP_BACKUP_STALE_HOURS in the environment replaces the limit (the rehearsal uses 0 to make every site stale at once).
set -u
. {{ wp_tools_lib }}/common.sh
readonly BACKUPS='{{ wp_backup_dir }}'
readonly STATE_DIR='{{ wp_disk_state_dir }}'
readonly TOPIC='{{ wp_ntfy_topic }}'
readonly HOST='{{ inventory_hostname }}'
readonly STALE_HOURS="${WP_BACKUP_STALE_HOURS:-{{ wp_backup_stale_hours }}}"
{% raw %}
notify() { ntfy-notify "$TOPIC" "$HOST $1"; }
mkdir -p "$STATE_DIR"
now=$(date +%s)
for site in $WP_SITES; do
  [[ $site =~ ^[a-z][a-z0-9-]{1,23}$ ]] || continue
  if [ -e "$WP_FREEZE" ] || [ -e "$WP_DATA/$site/freeze" ]; then continue; fi
  if [ -e "$WP_DATA/$site/stopped.flag" ]; then continue; fi   # stopped on purpose: its backup timer is off and there is no database to dump
  f="$STATE_DIR/backup-stale-$site.flag"
  ok="$BACKUPS/$site/.last-success"
  if [ -f "$ok" ]; then
    age=$(( (now - $(stat -c %Y "$ok")) / 3600 )); last=$(cat "$ok")
  elif [ -d "$WP_DATA/$site" ]; then
    age=$(( (now - $(stat -c %Y "$WP_DATA/$site")) / 3600 )); last=never
  else
    continue
  fi
  if [ "$last" = never ] && [ "$age" -ge "$STALE_HOURS" ] && [ "$(table_count "$site" 2>/dev/null)" = 0 ] && ! ls "$BACKUPS/$site"/[0-9]*T*Z >/dev/null 2>&1; then
    continue   # a site that is waiting for an import: no tables and no snapshot, so there is nothing to back up and nothing that could be stale
  fi
  if [ "$age" -ge "$STALE_HOURS" ]; then
    [ -f "$f" ] || { notify "site $site has no backup newer than ${STALE_HOURS} hours (last good: $last, ${age} hours ago): the nightly job is not producing backups"; touch "$f"; }
  elif [ -f "$f" ]; then
    notify "site $site has a fresh backup again ($last)"; rm -f "$f"
  fi
done
exit 0
{% endraw %}

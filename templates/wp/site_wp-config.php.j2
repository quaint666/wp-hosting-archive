{#- The eight salts and the database password derive from the master secret, the site name and secret_rev: bumping secret_rev rotates this site only. -#}
{% macro derive(purpose) -%}{{ (wp_secret_base ~ '|' ~ purpose) | hash('sha256') }}{%- endmacro -%}
<?php
// Managed by Ansible (templates/wp/site_wp-config.php.j2). Mounted read-only into the php container; edit the template, not this file.
define( 'DB_NAME', 'wordpress' );
define( 'DB_USER', 'wp' );
define( 'DB_PASSWORD', '{{ wp_db_password }}' );
define( 'DB_HOST', 'db' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

{% for key in ['AUTH_KEY', 'SECURE_AUTH_KEY', 'LOGGED_IN_KEY', 'NONCE_KEY', 'AUTH_SALT', 'SECURE_AUTH_SALT', 'LOGGED_IN_SALT', 'NONCE_SALT'] %}
define( '{{ key }}', '{{ derive(key) }}' );
{% endfor %}

$table_prefix = 'wp_';

define( 'WP_HOME', 'https://{{ wp_host }}' );
define( 'WP_SITEURL', 'https://{{ wp_host }}' );
define( 'COOKIE_DOMAIN', '{{ wp_host }}' );
define( 'FORCE_SSL_ADMIN', true );
define( 'WP_ENVIRONMENT_TYPE', 'production' );
define( 'WP_MEMORY_LIMIT', '{{ wp_s.php_memory_limit }}' );
define( 'WP_DEBUG', false );

// A systemd timer runs the due events; the per-visit cron stays off. No file edits or installs from the admin; our job updates through WP-CLI.
define( 'DISABLE_WP_CRON', true );
define( 'DISALLOW_FILE_MODS', true );
define( 'AUTOMATIC_UPDATER_DISABLED', true );

// The must-use plugins of the hosting service (templates/wp/mu/) live outside wp-content, in a root-owned directory mounted read-only; a friend's own mu-plugins folder is not loaded.
define( 'WPMU_PLUGIN_DIR', '{{ wp_mu_mount }}' );
define( 'WPMU_PLUGIN_URL', 'https://{{ wp_host }}/wp-mu' );
define( 'WP_HOSTING_LOGIN_LIMIT_IP', {{ wp_login_limit_ip | int }} );
define( 'WP_HOSTING_LOGIN_LIMIT_USER', {{ wp_login_limit_user | int }} );
define( 'WP_HOSTING_LOGIN_WINDOW_S', {{ wp_login_window_s | int }} );
define( 'WP_HOSTING_ALLOW_XMLRPC', {{ 'true' if wp_s.allow_xmlrpc else 'false' }} );
define( 'WP_HOSTING_ALLOW_APP_PASSWORDS', {{ 'true' if wp_s.allow_app_passwords else 'false' }} );
define( 'WP_HOSTING_ALLOW_USER_ENUM', {{ 'true' if wp_s.allow_user_enum else 'false' }} );
define( 'WP_HOSTING_2FA_ROLES', '{{ wp_2fa_roles }}' );
define( 'WP_HOSTING_TIMING', {{ wp_php_timing | int }} );
{% if wp_s.ai1wm_export %}

// All-in-One WP Migration keeps its exports in the writable uploads directory (the default, wp-content/ai1wm-backups, is read-only here). nginx answers 403 for that folder.
define( 'AI1WM_DEFAULT_BACKUPS_PATH', WP_CONTENT_DIR . '/uploads/ai1wm-backups' );
{% endif %}
define( 'WP_HOSTING_PLUGIN_REQUESTS_MAX', {{ wp_plugin_requests_max | int }} );
define( 'WP_HOSTING_MAIL_MODE', '{{ wp_s.mail_mode }}' );
define( 'WP_HOSTING_MAIL_FROM', '{{ wp_s.name }} <{{ wp_s.name }}@{{ wp_mail_sender_domain }}>' );
define( 'WP_HOSTING_MAIL_PER_HOUR', {{ wp_mail_per_hour | int }} );
define( 'WP_HOSTING_MAIL_PER_DAY', {{ wp_mail_per_day | int }} );
{% if wp_s.mail_mode == 'send' %}
define( 'WP_HOSTING_MAIL_KEY', '{{ dellwp_wp_resend_key }}' );
{% endif %}

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}
require_once ABSPATH . 'wp-settings.php';

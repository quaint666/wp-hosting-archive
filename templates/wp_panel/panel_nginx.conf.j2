# Managed by Ansible (templates/wp_panel/panel_nginx.conf.j2). TLS for the WordPress control app, on the overlay address only. The certificate is the fleet's wildcard (le_cert_dir), put there by
# aopenvms/deploy_le_cert_aopenpanel.yml and renewed by the HP's hook, which reloads this nginx. There is no port 80 and no other name: a request for anything but the app's own name is refused at the TLS
# handshake. server_tokens is set inside each server block, never at the top: this distribution's nginx.conf already sets it in http{} and a second one there fails nginx -t. Behind it the app listens on loopback. The body limit is small on purpose (the login form is the largest thing any page takes); the import page of a later step sets its own on its own location.
server {
    listen {{ overlay_ip }}:443 ssl default_server;
    ssl_reject_handshake on;
    server_tokens off;
}

server {
    listen {{ overlay_ip }}:443 ssl;
    http2 on;
    server_name {{ panel_domain }};
    server_tokens off;

    ssl_certificate {{ le_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ le_cert_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:panel_tls:2m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    # Installing WordPress, setting a password and the vulnerability check wait for the tool on dellwp (its limits are 600, 300 and 300 seconds): the app asks wp-ctl synchronously, so nginx waits longer for these three pages only.
    location ~ ^/sites/[a-z0-9-]+/(install|password|security)$ {
        proxy_pass http://{{ panel_bind }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 700s;
    }

    # The upload of the import page: the file is the raw body of a PUT and goes through to the app a piece at a time, never kept by nginx (proxy_request_buffering off, so there is no copy on this VM's disk and the
    # app sees the bytes as they arrive). The limit is the intake quota of dellwp; a body that stalls for 5 minutes is dropped; the answer may take as long as wp-ctl lets the receive run (4 hours).
    location ~ ^/import/files/[A-Za-z0-9._-]+$ {
        limit_except PUT { deny all; }
        client_max_body_size {{ panel_upload_max_mb }}m;
        client_body_timeout 300s;
        proxy_request_buffering off;
        proxy_pass http://{{ panel_bind }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 15000s;
        proxy_read_timeout 15000s;
    }

    location / {
        proxy_pass http://{{ panel_bind }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
